# FORE Static Page Generator — environment variables
#
# Copy this file to .env (untracked — already covered by standard git
# hygiene conventions; do not commit real values) and fill in real values
# for local development. In production, set these in the Vercel project's
# Settings -> Environment Variables, not in a committed file.

# Supabase project URL — the same project already used by the live site's
# api/*.js functions. Not a secret.
SUPABASE_URL=

# Supabase SERVICE ROLE key — server-side / build-time only. Grants full
# read access independent of the Row Level Security policies that govern
# browser (anon key) access. Never expose this in client-side code or
# commit a real value. Reuses the same variable name already used by
# api/sync-listings.js and api/sync-pf-listings.js.
SERVICE_KEY=

# Absolute base URL of the production site. Used to build canonical URLs,
# Open Graph tags, and sitemap entries once real page generation exists.
SITE_BASE_URL=

# Optional: minimum log level for the generator (debug | info | warn | error).
# If unset, generator/lib/logger.mjs defaults to "info".
GENERATOR_LOG_LEVEL=
