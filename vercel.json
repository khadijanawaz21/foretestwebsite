{
  "buildCommand": "node generator/build.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/20-80",
      "destination": "/20-80/index.html"
    }
  ],
  "functions": {
    "api/sync-listings.js": {
      "maxDuration": 60
    },
    "api/sync-pf-listings.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-listings",
      "schedule": "0 6 * * *"
    }
  ]
}
